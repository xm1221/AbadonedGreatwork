{
  "schemaVersion": 1,
  "id": "abadoned_greatwork",
  "version": "${version}",
  "name": "Abadoned Greatwork",
  "description": "Abadoned Greatwork addon for Hex Casting",
  "authors": [
    "xm1221"
  ],
  "contact": {
    "homepage": "https://xm1221.github.io/AbadonedGreatwork",
    "sources": "https://github.com/xm1221/AbadonedGreatwork"
  },
  "license": "MIT",
  "icon": "assets/abadoned_greatwork/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.abadoned_greatwork.fabric.FabricAbadoned_greatwork"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.abadoned_greatwork.fabric.FabricAbadoned_greatworkClient"
    }],
    "server": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.abadoned_greatwork.fabric.FabricAbadoned_greatworkServer"
    }],
    "fabric-datagen": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.abadoned_greatwork.fabric.datagen.FabricAbadoned_greatworkDatagen"
    }],
    "modmenu": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.abadoned_greatwork.fabric.FabricAbadoned_greatworkModMenu"
    }]
  },
  "mixins": [
    "abadoned_greatwork-common.mixins.json",
    "abadoned_greatwork-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "hexcasting": ">=${versions.hexcasting}",
    "cloth-config": ">=${versions.clothConfig}"
  },
  "suggests": {
    "modmenu": ">=${versions.modMenu}"
  }
}
